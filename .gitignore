# Unreal Engine – generated folders (rebuilt automatically)
Game/Binaries/
Game/Intermediate/
Game/Saved/
Game/DerivedDataCache/
Game/Plugins/*/Binaries/
Game/Plugins/*/Intermediate/
Game/.vs/
Game/*.sln
Game/*.vsconfig
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Machine-local settings
Game/Config/Windows/WindowsEngine.ini
Tools/local.bat

# Local copy of the EOS plugin (see docs/03 §6.4, §6.6)
Game/Plugins/OnlineSubsystemEOS_Local/

# Models, animations and sounds from Fab or other stores: their licences allow shipping them inside the
# packaged game, but not publishing the source files in a public repository. They stay on your PC only.
# Only the game's own folder is tracked; everything else under Content is a store pack.
Game/Content/*
!Game/Content/HowCouldItBeYou/
# The English texts (Tools/Localize.bat)
!Game/Content/Localization/
# ... but not the reports Localize.bat writes next to them
Game/Content/Localization/Game/Game.csv
Game/Content/Localization/Game/Game_Conflicts.txt

# Secrets
*.key
*.pem
.env

# Packaged game, release zips, built launcher
Build/

# Launcher / Backend build output
Launcher/bin/
Launcher/obj/
Launcher/target/
Launcher/**/node_modules/
Launcher/**/dist/
Backend/**/node_modules/
Backend/.wrangler/

# Bought or licensed sound recordings (see Sounds/LIES-MICH.txt): they stay on your PC and inside the packaged game
Sounds/*
!Sounds/LIES-MICH.txt

Tools/PatchTool/bin/
Tools/PatchTool/obj/
