#. Key:	Story1
#. SourceLocation:	Source/HowCouldItBeYou/UI/HCIntroWidget.cpp(43)
#: Source/HowCouldItBeYou/UI/HCIntroWidget.cpp(43)
msgctxt "HC,Story1"
msgid "Forschungsstation Kepler-7, im Orbit. Seit 41 Tagen untersucht eure Crew eine Probe aus dem Eis des Jupitermonds Europa. Sie lag ruhig in ihrem Glas. Bis heute Nacht."
msgstr "Forschungsstation Kepler-7, im Orbit. Seit 41 Tagen untersucht eure Crew eine Probe aus dem Eis des Jupitermonds Europa. Sie lag ruhig in ihrem Glas. Bis heute Nacht."

#. Key:	Story2Head
#. SourceLocation:	Source/HowCouldItBeYou/UI/HCIntroWidget.cpp(44)
#: Source/HowCouldItBeYou/UI/HCIntroWidget.cpp(44)
msgctxt "HC,Story2Head"
msgid "TAG 41  ·  03:12 STATIONSZEIT  ·  BIO-LABOR"
msgstr "TAG 41  ·  03:12 STATIONSZEIT  ·  BIO-LABOR"

#. Key:	Story2
#. SourceLocation:	Source/HowCouldItBeYou/UI/HCIntroWidget.cpp(45)
#: Source/HowCouldItBeYou/UI/HCIntroWidget.cpp(45)
msgctxt "HC,Story2"
msgid "Das Glas sprang. Was darin lag, berührte Ingenieur Brandt, und plötzlich standen zwei Brandts im Labor. Kommandant Hale hob seine Lampe. Von ihm blieb nur seine Marke."
msgstr "Das Glas sprang. Was darin lag, berührte Ingenieur Brandt, und plötzlich standen zwei Brandts im Labor. Kommandant Hale hob seine Lampe. Von ihm blieb nur seine Marke."

#. Key:	Story3Head
#. SourceLocation:	Source/HowCouldItBeYou/UI/HCIntroWidget.cpp(46)
#: Source/HowCouldItBeYou/UI/HCIntroWidget.cpp(46)
