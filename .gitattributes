* text=auto
# Windows scripts always with CRLF, otherwise cmd.exe may misread them
*.bat text eol=crlf
*.cmd text eol=crlf

# Unreal binary assets via Git LFS
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text

# Raw files only under Game/ via LFS (launcher icons stay normal git files)
Game/**/*.png filter=lfs diff=lfs merge=lfs -text
Game/**/*.wav filter=lfs diff=lfs merge=lfs -text
Game/**/*.fbx filter=lfs diff=lfs merge=lfs -text
Game/**/*.ogg filter=lfs diff=lfs merge=lfs -text
