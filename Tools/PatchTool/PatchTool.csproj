<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Release side of the launcher's small updates: cuts a packaged game into chunks and writes
    HowCouldItBeYou-<Platform>-<tag>.manifest.json + .chunks next to the release zip (see Tools/Package.ps1).
    Shared/ (chunking, manifest, binary patches) is compiled into the launcher too, so both cut identically.
    It lives here, not in Launcher/, because release copies of the project (hcrel, hclinux) carry Tools/ only.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PatchTool</AssemblyName>
    <RootNamespace>HowCouldItBeYou.PatchTool</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

</Project>
